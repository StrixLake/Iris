<UserControl x:Class="Iris.UI.Markdown"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Iris.UI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      mc:Ignorable="d">

    <UserControl.Resources>

        <AcrylicBrush x:Key="BlackBrush" TintOpacity="0.2" TintLuminosityOpacity="0.1" TintColor="{ThemeResource SystemAccentColor}"/>

        <MenuFlyout x:Name="MarkdownFlyout">
            <MenuFlyoutItem Text="Edit" Click="Edit_Start"/>
            <MenuFlyoutItem Text="Select All"/>
            <MenuFlyoutItem Text="Select Block"/>
            <MenuFlyoutItem Text="Delete"/>
            <MenuFlyoutItem Text="Regenerate"/>
            <MenuFlyoutItem Text="Logs" Click="OpenLogs"/>
        </MenuFlyout>

        <Flyout x:Name="LogsFlyout">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="MaxWidth" Value="1200"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Flyout.FlyoutPresenterStyle>

            <Border CornerRadius="14" 
                    Padding="10"
                    Background="{ThemeResource BlackBrush}">
                
                <controls:MarkdownTextBlock x:Name="LogsBlock"
                                            Background="Transparent"/>

            </Border>
            
        </Flyout>
        
    </UserControl.Resources>
    
    <Grid>

        <controls:MarkdownTextBlock x:Name="InnerMarkdown"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    MarkdownRendered="Markdown_Rendered"
                                    Background="Transparent"/>
        
        <TextBlock x:Name="InnerTextBlock"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Visibility="Collapsed"
                   TextWrapping="WrapWholeWords"/>

        <TextBox x:Name="InnerTextBox_Edit"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Visibility="Collapsed"
                 AcceptsReturn="True"
                 TextWrapping="Wrap">
            <TextBox.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Edit_Complete"/>
            </TextBox.KeyboardAccelerators>
        </TextBox>

    </Grid>
    

</UserControl>