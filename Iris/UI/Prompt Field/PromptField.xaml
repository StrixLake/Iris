<UserControl x:Class="Iris.UI.PromptField"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Iris.UI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Prompt Field/PromptFieldStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:StringToImage x:Key="ImageConverter"/>
            <local:FileConverter x:Key="FileConverter"/>
            <BackEase x:Key="Easing" EasingMode="EaseOut"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel RenderTransformOrigin="0.5,1">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="promptFieldTransform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="0.8" Duration="0:0:0.2"
                                         EasingFunction="{StaticResource Easing}"/>
                        <DoubleAnimation Storyboard.TargetName="promptFieldTransform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="0.65" Duration="0:0:0.2"
                                         EasingFunction="{StaticResource Easing}"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ModelButton"
                                                       Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="ModelSwitchTransform.ScaleX" Value="0"/>
                        <Setter Target="fieldBorder.BorderThickness" Value="0"/>
                        <Setter Target="textField.PlaceholderText" Value=""/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Expanded">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="promptFieldTransform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1" Duration="0:0:0.2"
                                         EasingFunction="{StaticResource Easing}"/>
                        <DoubleAnimation Storyboard.TargetName="promptFieldTransform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1" Duration="0:0:0.2"
                                         EasingFunction="{StaticResource Easing}"/>
                        <DoubleAnimation Storyboard.TargetName="ModelSwitchTransform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1" Duration="0:0:0.2"
                                         EasingFunction="{StaticResource Easing}"/>
                    </Storyboard>
                    <VisualState.Setters>
                        <Setter Target="ModelSwitchTransform.ScaleX" Value="1"/>
                        <Setter Target="fieldBorder.BorderThickness" Value="2,0,2,2"/>
                        <Setter Target="textField.PlaceholderText" Value="(Ctrl + Enter to send)"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="DescriptionState">
                    <VisualState.Setters>
                        <Setter Target="descriptionFlyout.Visibility" Value="Visible"/>
                        <Setter Target="DescriptionButton.Background" Value="#40FFFFFF"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ProviderState">
                    <VisualState.Setters>
                        <Setter Target="Endpoints.Visibility" Value="Visible"/>
                        <Setter Target="descriptionFlyout.Visibility" Value="Collapsed"/>
                        <Setter Target="ProviderButton.Background" Value="#40FFFFFF"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel.RenderTransform>
            <ScaleTransform x:Name="promptFieldTransform"/>
        </StackPanel.RenderTransform>

        <ScrollView ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled">

            <StackPanel Orientation="Horizontal">

                <ItemsRepeater ItemsSource="{x:Bind images, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid PointerEntered="Grid_PointerEntered"
                                  PointerExited="Grid_PointerExited">

                                <Image Source="{Binding Converter={StaticResource ImageConverter}}"/>
                                <Button x:Name="DeleteButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Height="20" Width="20"
                                        Background="#8F000000" Foreground="White" Padding="0"
                                        Visibility="Collapsed"
                                        Click="Delete_Image">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <ItemsRepeater ItemsSource="{x:Bind fileAttachments, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid PointerEntered="Grid_PointerEntered"
                                  PointerExited="Grid_PointerExited">

                                <Button Content="{Binding Converter={StaticResource FileConverter}}">
                                    <Button.Background>
                                        <AcrylicBrush TintOpacity="0.5" TintColor="Black"/>
                                    </Button.Background>
                                </Button>
                                <Button x:Name="DeleteButton"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Height="20" Width="20"
                                        Background="#8F000000" Foreground="White" Padding="0"
                                        Visibility="Collapsed"
                                        Click="Delete_file">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            </StackPanel>
        </ScrollView>

        <Border x:Name="fieldBorder"
                CornerRadius="12" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                BorderThickness="2,0,2,2"
                Background="#20FFFFFF">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="1,0" EndPoint="1,1">
                    <GradientStop Color="Black" Offset="0.5"/>
                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="textField"
                         Grid.Row="0" AcceptsReturn="True"
                         Padding="20"
                         KeyboardAcceleratorPlacementMode="Hidden">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste"/>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="SendMessage"/>
                    </TextBox.KeyboardAccelerators>
                </TextBox>

                <Button Grid.Row="1" Margin="20, 0, 20, 20" Content="{x:Bind settings.Name, Mode=OneWay}"
                        CornerRadius="14" x:Name="ModelButton">

                    <Button.RenderTransform>
                        <ScaleTransform x:Name="ModelSwitchTransform"/>
                    </Button.RenderTransform>
                    
                    <Button.Flyout>
                        <Flyout x:Name="modelFlyout">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="800"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <Border CornerRadius="14" 
                                    Padding="10"
                                    Background="{ThemeResource BlackBrush}"
                                    Width="800"
                                    Height="500">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    
                                    <ListView Grid.Column="0" Grid.Row="0"
                                              ItemsSource="{x:Bind settings.Models, Mode=OneWay}"
                                              Background="#0FFFFFFF" CornerRadius="12"
                                              Padding="2,8,2,2"
                                              SelectedItem="{x:Bind settings.Model}" SelectionChanged="ChangeSelectedModel">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}">
                                                    <TextBlock.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Delete" Click="RemoveModel"/>
                                                        </MenuFlyout>
                                                    </TextBlock.ContextFlyout>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBox PlaceholderText="Add Model"
                                             Margin="0,6,0,0"
                                             x:Name="ModelAddField"
                                             KeyboardAcceleratorPlacementMode="Hidden"
                                             Grid.Column="0" Grid.Row="1">
                                        <TextBox.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Enter" Invoked="AddModel"/>
                                        </TextBox.KeyboardAccelerators>
                                    </TextBox>


                                    <Grid Grid.Row="0" Grid.Column="1"
                                          Background="#0FFFFFFF"
                                          CornerRadius="12"
                                          Padding="8"
                                          Margin="10,0,0,0">
                                        <controls:MarkdownTextBlock x:Name="descriptionFlyout"
                                                                    Text="{x:Bind settings.Description, Mode=OneWay}"
                                                                    Background="Transparent"
                                                                    TextWrapping="WrapWholeWords"
                                                                    Margin="10, 0, 10, 0"/>
                                        <ContentControl x:Name="Endpoints" Visibility="Collapsed"
                                                        HorizontalContentAlignment="Stretch"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <Button Content="Description" x:Name="DescriptionButton" Margin="0,5,10,0" CornerRadius="14"/>
                                        <Button Content="Providers" x:Name="ProviderButton" Margin="0,5,10,0" CornerRadius="14"/>
                                    </StackPanel>
                                        

                                </Grid>

                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

            </Grid>

        </Border>

    </StackPanel>

</UserControl>