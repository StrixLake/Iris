<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iris.UI">

    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Black"/>
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="Black"/>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    <AcrylicBrush x:Key="BlackBrush" TintOpacity="0.2" TintLuminosityOpacity="0.1" TintColor="{ThemeResource SystemAccentColor}"/>

</ResourceDictionary>
