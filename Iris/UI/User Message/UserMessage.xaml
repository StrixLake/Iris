<UserControl x:Class="Iris.UI.UserMessage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Iris.UI"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      mc:Ignorable="d">

    <UserControl.Resources>
        <local:StringToImage x:Key="ImageConverter"/>
        <local:FileConverter x:Key="FileConverter"/>
        <MenuFlyout x:Name="attachmentOptions">
            <MenuFlyoutItem Text="Delete"/>
        </MenuFlyout>
    </UserControl.Resources>

    <Border BorderThickness="1,1,1,0"
            CornerRadius="8"
            HorizontalAlignment="Stretch"
            Padding="20,10,10,10"
            BorderBrush="{ThemeResource SystemAccentColorDark2}">

        <StackPanel VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal">
                <!--> image list <-->
                <ListView x:Name="ImageList"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          SelectionMode="None"
                          ItemsSource="{x:Bind message.images}">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4">
                                <Image Source="{Binding Converter={StaticResource ImageConverter}}"
                                       ContextFlyout="{StaticResource attachmentOptions}"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <!--> files list <-->

                <ListView x:Name="FileList"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          SelectionMode="None"
                          ItemsSource="{x:Bind message.files}">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4">
                                <Button Content="{Binding Converter={StaticResource FileConverter}}"
                                        ContextFlyout="{StaticResource attachmentOptions}"
                                        Click="OpenFileViewer"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>


                </ListView>
            </StackPanel>

            <ContentControl x:Name="MarkdownControl"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </StackPanel>
    
    </Border>

</UserControl>