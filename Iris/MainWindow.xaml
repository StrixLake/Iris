<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iris"
    xmlns:core="using:Iris.Core"
    xmlns:ui="using:Iris.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Page x:Name="rootPage">

        <Grid Background="Black">

            <Grid.Resources>
                <AcrylicBrush x:Key="BlackBrush" TintOpacity="0.1" TintLuminosityOpacity="0" TintColor="{StaticResource SystemAccentColor}"/>
                <CubicEase x:Key="HistoryEasing"/>
            </Grid.Resources>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="HistoryOpen">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BorderTranslate"
                                             Storyboard.TargetProperty="X"
                                             Duration="0:0:0.2"
                                             From="-260" To="0"
                                             EasingFunction="{StaticResource HistoryEasing}"/>
                            <DoubleAnimation Storyboard.TargetName="ChatBlur"
                                             Storyboard.TargetProperty="Amount"
                                             EnableDependentAnimation="True"
                                             Duration="0:0:0.2"
                                             From="0" To="30"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HistoryGrid"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame Value="Visible" KeyTime="0:0:0"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    
                    <VisualState x:Name="HistoryClose">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="BorderTranslate"
                                             Storyboard.TargetProperty="X"
                                             Duration="0:0:0.2"
                                             From="0" To="-260"
                                             EasingFunction="{StaticResource HistoryEasing}"/>
                            <DoubleAnimation Storyboard.TargetName="ChatBlur"
                                             Storyboard.TargetProperty="Amount"
                                             EnableDependentAnimation="True"
                                             Duration="0:0:0.2"
                                             From="30" To="0"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HistoryGrid"
                                                           Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame Value="Collapsed" KeyTime="0:0:0.2"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            
            <!--the main content area-->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <ContentControl x:Name="MainContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Grid.Column="1"/>

                <Grid Background="Transparent" Grid.Column="0"
                      x:Name="HistoryAreaOpen"/>

            </Grid>

            <!--History area-->
            
            <Grid x:Name="HistoryGrid"
                  Visibility="Collapsed">
                
                <Grid.Background>
                    <media:BackdropBlurBrush Amount="0" x:Name="ChatBlur"/>
                </Grid.Background>

                <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Width="250" CornerRadius="0, 20, 20, 0"
                        x:Name="HistoryBorder">

                    <Border.Background>
                        <AcrylicBrush TintColor="{ThemeResource SystemAccentColorDark1}"
                                      TintOpacity="0.3"
                                      TintLuminosityOpacity="0.4"/>
                    </Border.Background>

                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BorderTranslate"/>
                    </Border.RenderTransform>

                    <StackPanel>

                        <Button Content="New Chat" Click="NewChat"
                                Margin="10" CornerRadius="8"/>

                        <ListView HorizontalAlignment="Stretch" ItemsSource="{x:Bind sessions}"
                                  Margin="0,5,0,0" x:Name="SessionList"
                                  SelectionChanged="ChangeSession">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:Object">
                                    <TextBlock Text="{x:Bind local:MainWindow.TitleConverter((x:Object))}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

    </Page>
</Window>
