<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Iris.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iris"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d"
    Title="Iris">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid x:Name="backgroundCanvas" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="Black" Offset="0.0"/>
                    <GradientStop Color="{x:Bind activeChat.Status, Mode=OneWay}" Offset="0.8" x:Name="StatusColor"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Rectangle Fill="Black" Opacity="0.8"/>
        </Grid>

        <!--main chat window-->
        
        <Grid>

            <Grid.Background>
                <media:BackdropBlurBrush Amount="20"/>
            </Grid.Background>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.1*"/>
            </Grid.ColumnDefinitions>

            <local:ChatPage x:Name="chatPage" Grid.Column="1"/>

            <Grid Grid.Column="2" PointerEntered="Grid_PointerEntered" Background="Transparent"/>
            <Grid Grid.Column="0" PointerEntered="Grid_PointerEntered_History" Background="Transparent"/>

        </Grid>

        <!--side panel-->

        <Grid x:Name="optionPanelGrid" Visibility="Collapsed" IsHitTestVisible="False">

            <Grid.Resources>
                <Storyboard x:Name="panelSlideAnimation" Completed="panelSlideAnimation_Completed">
                    <DoubleAnimation From="0" To="1" Duration="00:00:0.2"
                                             Storyboard.TargetName="optionPanelScale"
                                             Storyboard.TargetProperty="ScaleX">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation From="0" To="20" Duration="00:00:0.2"
                                     Storyboard.TargetName="panelBlur"
                                     Storyboard.TargetProperty="Amount"
                                     EnableDependentAnimation="True">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <Storyboard x:Name="panelCollapseAnimation" Completed="panelCollapseAnimation_Completed">
                    <DoubleAnimation From="1" To="0" Duration="00:00:0.2"
                                             Storyboard.TargetName="optionPanelScale"
                                             Storyboard.TargetProperty="ScaleX">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation From="20" To="0" Duration="00:00:0.2"
                                     Storyboard.TargetName="panelBlur"
                                     Storyboard.TargetProperty="Amount"
                                     EnableDependentAnimation="True">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <Storyboard x:Name="historyPanelSlideAnimation" Completed="panelSlideAnimation_Completed">
                    <DoubleAnimation From="0" To="1" Duration="00:00:0.2"
                                             Storyboard.TargetName="historyPanelScale"
                                             Storyboard.TargetProperty="ScaleX">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation From="0" To="20" Duration="00:00:0.2"
                                             Storyboard.TargetName="panelBlur"
                                             Storyboard.TargetProperty="Amount"
                                     EnableDependentAnimation="True">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <Storyboard x:Name="historyPanelCollapseAnimation" Completed="panelCollapseAnimation_Completed">
                    <DoubleAnimation From="1" To="0" Duration="00:00:0.2"
                                             Storyboard.TargetName="historyPanelScale"
                                             Storyboard.TargetProperty="ScaleX">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation From="20" To="0" Duration="00:00:0.2"
                                             Storyboard.TargetName="panelBlur"
                                             Storyboard.TargetProperty="Amount"
                                     EnableDependentAnimation="True">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

            </Grid.Resources>

            <Grid.Background>
                <media:BackdropBlurBrush Amount="0" x:Name="panelBlur"/>
            </Grid.Background>
            

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Background="Transparent" Grid.Column="2" PointerEntered="optionPanel_PointerExited"/>

            <local:OptionPanel Width="250" x:Name="optionPanel"
                               Grid.Column="3" CornerRadius="4" RenderTransformOrigin="1,1">
                <local:OptionPanel.RenderTransform>
                    <ScaleTransform x:Name="optionPanelScale" ScaleX="0"/>
                </local:OptionPanel.RenderTransform>
            </local:OptionPanel>

            <!--history panel-->
            <Grid Background="Transparent" Grid.Column="1" PointerEntered="historyPanel_PointerExited"/>

            <local:HistoryPanel x:Name="historyPanel" Width="250" Grid.Column="0">
                <local:HistoryPanel.RenderTransform>
                    <ScaleTransform x:Name="historyPanelScale" ScaleX="0"/>
                </local:HistoryPanel.RenderTransform>
            </local:HistoryPanel>

        </Grid>


    </Grid>
</Window>
